# Caddyfile *inside* the container. Plain HTTP on :80 — TLS and the public
# hostname are the job of the reverse proxy already running on the VPS.
:80 {
	root * /srv
	encode zstd gzip
	file_server

	# Storybook writes content-hashed filenames into assets/, so they can be
	# cached forever. Everything else must revalidate or a deploy goes unseen.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Unhashed and rewritten on every deploy, so they must revalidate rather
	# than sit in a cache serving last week's component list.
	@html path *.html / /llms.txt /index.json
	header @html Cache-Control "no-cache"
}
